#!/bin/sh
# pre-push 门禁（2026-08-28 审计 P1-13）：推送前先跑最快的两道静态检查，
# 堵住"本地可绕过提交、全靠 CI 兜底"的缺口。与 CI quality.yml 完整链互补。
# 跳过：git push --no-verify（紧急通道，CI 仍会拦）。
#
# 2026-08-29 两次修：GUI 应用（VS Code 等）拉起的钩子环境 PATH 与终端不同——
# 裸 `npm` 会命中 Node 自带的无扩展名 bash 脚本版（#!/usr/bin/env bash），
# 该环境没有 bash/env 直接报 "No such file or directory" 挡推；npm.cmd 探测
# 在部分 GUI 环境同样不可靠。最终解：完全绕开 npm，用 node 直调两个 bin 的
# JS 入口；node 找不到时按绝对安装路径兜底，再找不到才放行（CI 仍会拦）。
NODE=""
if command -v node >/dev/null 2>&1; then
  NODE=node
elif [ -x "/c/Program Files/nodejs/node.exe" ]; then
  NODE="/c/Program Files/nodejs/node.exe"
elif [ -x "$LOCALAPPDATA/Programs/nodejs/node.exe" ] ; then
  NODE="$LOCALAPPDATA/Programs/nodejs/node.exe"
fi
if [ -z "$NODE" ]; then
  echo "[pre-push] 未找到 node，跳过本地推送门禁（CI quality.yml 仍会完整拦截）" >&2
  exit 0
fi
echo "[pre-push] typecheck:app + lint:js"
cd "$(git rev-parse --show-toplevel)" || exit 1
"$NODE" node_modules/vue-tsc/bin/vue-tsc.js -p tsconfig.app.json --noEmit || exit 1
"$NODE" node_modules/eslint/bin/eslint.js src routes services scripts || exit 1
